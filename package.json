{
  "name": "elysia-template-v4",
  "version": "1.0.0",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "migration:create": "bunx mikro-orm migration:create",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/opentelemetry": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@mikro-orm/core": "^6.4.5",
    "@mikro-orm/migrations": "^6.4.5",
    "@mikro-orm/postgresql": "^6.4.5",
    "elysia": "^1.2.25",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.5",
    "@types/jsonwebtoken": "^9.0.8",
    "bun-types": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "mikro-orm": {
    "configPaths": ["./src/mikro-orm.config.ts"]
  }
}
