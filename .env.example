PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elysia-template

# generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# pool sizing: in cluster mode total = workers * DB_POOL_MAX
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_MS=30000

# number of workers to run the app in cluster mode
# if not set or set to 1, the app will run in single mode
WORKER_THREADS=1
# swagger is auto-enabled outside production; opt-in for prod:
# ENABLE_SWAGGER=true

# Redis URL for:
# - MikroORM result cache: src/utils/RedisCacheAdapter.ts if not set uses MemoryCacheAdapter
# - Redis Lock if not set RedisLock will not work: src/utils/RedisLock.ts
# - BullMQ job queue + worker (src/worker.ts): REQUIRED if you run the worker
REDIS_URL=redis://localhost:6379

# Bull Board dashboard at /api/admin/queues — requires an admin JWT.
# Off by default; opt in per environment.
ENABLE_BULL_BOARD=false

# jobs processed in parallel per worker process (src/worker.ts)
WORKER_CONCURRENCY=5

# Bull Board dashboard at /api/admin/queues — protected by HTTP Basic Auth
# (browser-native login prompt), not the app's JWT. Required if ENABLE_BULL_BOARD=true.
ENABLE_BULL_BOARD=false
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin